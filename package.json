{
  "name": "funding-finder-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server for SBIR/STTR and federal grants: Grants.gov, NIH RePORTER and NSF Award Search.",
  "scripts": {
    "dev": "netlify dev --offline",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "stdio": "tsx src/stdio.ts",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:contract": "vitest run test/contract",
    "demo": "tsx scripts/demo.ts",
    "inspect": "npx -y @modelcontextprotocol/inspector@2.11.0 --cli https://grants.thelconsulting.com/mcp --transport http --method tools/list",
    "scan:secrets": "bash scripts/secrets-scan.sh",
    "inspect:local": "npx -y @modelcontextprotocol/inspector@2.11.0 --cli http://localhost:8888/mcp --transport http --method tools/list",
    "demo:local": "tsx scripts/demo.ts http://localhost:8888/mcp"
  },
  "author": "Thel Consulting",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@netlify/blobs": "^11.1.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.2",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "funding-finder-mcp": "dist/src/stdio.js"
  },
  "homepage": "https://grants.thelconsulting.com",
  "keywords": [
    "federal-funding-finder",
    "thel-consulting"
  ]
}
